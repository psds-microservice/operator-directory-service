APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8095
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=operator_directory_service
DB_SSLMODE=disable

# URL of operator-pool-service for status/list
OPERATOR_POOL_URL=http://localhost:8094
# Optional: timeout (sec), retries, backoff (ms) for pool client
POOL_TIMEOUT_SEC=10
POOL_MAX_RETRIES=3
POOL_RETRY_BACKOFF_MS=500
